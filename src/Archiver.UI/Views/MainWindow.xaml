<Window x:Class="Archiver.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Archiver.UI.ViewModels"
        xmlns:views="clr-namespace:Archiver.UI.Views"
        xmlns:converters="clr-namespace:Archiver.UI.Converters"
        Title="{Binding CurrentPageTitle, StringFormat='Archiver - {0}'}"
        Height="700" Width="1100" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <DataTemplate DataType="{x:Type vm:ServiceStatusViewModel}">
            <views:ServiceStatusPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobsPageViewModel}">
            <views:JobsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsPageViewModel}">
            <views:LogsPage/>
        </DataTemplate>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <StackPanel Margin="12">
                <TextBlock Text="Archiver" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20"/>

                <!-- Service Status -->
                <Button Content="📊 Service Status" Margin="0,2"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowServiceStatusCommand}"/>

                <!-- Jobs -->
                <Button Content="📋 Copy Jobs" Margin="0,2"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowJobsCommand}"/>

                <!-- Logs -->
                <Button Content="📝 Logs" Margin="0,2"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowLogsCommand}"/>

                <Separator Margin="0,20,0,10"/>

                <!-- Service control indicator -->
                <StackPanel Margin="10,0">
                    <TextBlock Text="Service:" Foreground="Gray" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="10" Height="10" Fill="{Binding ServiceStatus.IsRunning, Converter={StaticResource BoolToColor}}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ServiceStatus.StatusText}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Content Area ─────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Padding="16,12">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="SemiBold"/>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
