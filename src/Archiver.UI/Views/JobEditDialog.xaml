<Window x:Class="Archiver.UI.Views.JobEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Archiver.UI.Converters"
        Title="Edit Job" Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Copy Job Configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Name & Enabled -->
            <TextBlock Text="Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,0,12"/>

            <!-- Source -->
            <TextBlock Text="SOURCE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <Separator Margin="0,0,0,8"/>

            <TextBlock Text="Source Path *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                <Button Grid.Column="1" Content="..." Width="32" Height="28" Margin="4,0,0,0"
                        Command="{Binding BrowseSourceCommand}"/>
            </Grid>

            <TextBlock Text="File Filter (e.g. *.bak;*.zip) — leave empty for all files" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <CheckBox Content="Include Subdirectories" IsChecked="{Binding IncludeSubdirectories}" Margin="0,0,0,12"/>

            <!-- Destinations -->
            <TextBlock Text="DESTINATIONS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <Separator Margin="0,0,0,8"/>

            <TextBlock Text="Network Share (UNC path)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DestinationNetworkPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Local/USB Path (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding DestinationLocalPath, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                <Button Grid.Column="1" Content="..." Width="32" Height="28" Margin="4,0,0,0"
                        Command="{Binding BrowseLocalDestCommand}"/>
            </Grid>

            <!-- Schedule -->
            <TextBlock Text="SCHEDULE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <Separator Margin="0,0,0,8"/>

            <TextBlock Text="Schedule Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding ScheduleTypes}" SelectedItem="{Binding ScheduleType}"
                      Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Daily Times (HH:mm, semicolons)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DailyTimes, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Interval (minutes, for Interval mode)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Cron Expression (for Cron mode)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <!-- Credentials -->
            <TextBlock Text="NETWORK CREDENTIALS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <Separator Margin="0,0,0,8"/>

            <TextBlock Text="Credential Name (select existing or type new)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableCredentials}" Text="{Binding CredentialName, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CredentialUsername, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,4"/>

            <TextBlock Text="Domain (optional — omit for workgroup)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CredentialDomain, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,4"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CredentialPasswordBox" Height="28" Margin="0,0,0,8"
                         PasswordChanged="CredentialPasswordBox_PasswordChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Test Connection" Height="30" Width="130"
                        Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ConnectionTestResult}" Foreground="Gray"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <Separator Margin="0,8,0,0"/>

            <!-- Cleanup -->
            <TextBlock Text="SOURCE CLEANUP / TRIM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <Separator Margin="0,0,0,8"/>

            <CheckBox Content="Enable Cleanup (delete old files after copy)" IsChecked="{Binding CleanupEnabled}" Margin="0,0,0,8"/>

            <TextBlock Text="Retention (days) — files older than this are deleted" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <TextBlock Text="Min Free Disk % (stop cleanup if disk is below this)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding MinFreeDiskPercent, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

            <CheckBox Content="Remove Empty Subdirectories After Cleanup" IsChecked="{Binding RemoveEmptyDirectories}" Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Delete Job" Width="100" Height="34"
                        Background="{StaticResource RedBrush}" Foreground="White" BorderThickness="0"
                        Command="{Binding DeleteCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsNew, Converter={StaticResource InverseBool}}"/>
                <Button Content="Cancel" Width="80" Height="34"
                        IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Save" Width="100" Height="34"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
