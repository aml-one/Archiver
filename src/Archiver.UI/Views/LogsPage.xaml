<UserControl x:Class="Archiver.UI.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Logs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
            <ComboBox ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedDate}"
                      Width="120" Height="28" Margin="0,0,12,0"/>

            <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLevel}"
                      Width="100" Height="28" Margin="0,0,12,0"/>

            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="Gray"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Height="28" VerticalContentAlignment="Center"/>

            <Button Content="🔍" Height="28" Width="36" Margin="8,0,0,0"
                    Command="{Binding LoadLogsCommand}" BorderThickness="0"/>
            <Button Content="↻" Height="28" Width="36" Margin="4,0,0,0"
                    Command="{Binding LoadLogsCommand}" BorderThickness="0"/>
        </StackPanel>

        <!-- Info -->
        <TextBlock Grid.Row="1" Foreground="Gray" FontSize="12" Margin="0,0,0,6">
            <Run Text="Showing "/><Run Text="{Binding Entries.Count, Mode=OneWay}"/><Run Text=" entries"/>
        </TextBlock>

        <!-- Log List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
            <ListView ItemsSource="{Binding Entries}" BorderThickness="0"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               FontFamily="Consolas" FontSize="12" Foreground="#666"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Level" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}" FontFamily="Consolas" FontSize="12"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARNING">
                                                        <Setter Property="Foreground" Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Information">
                                                        <Setter Property="Foreground" Value="#2196F3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Category" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Category}" FontFamily="Consolas" FontSize="12"
                                               Foreground="#888" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Message" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
