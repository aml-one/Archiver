<Application x:Class="Archiver.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Base application styling -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9E9E9E"/>
    </Application.Resources>
</Application>
